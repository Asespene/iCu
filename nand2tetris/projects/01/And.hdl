// File name: projects/01/And.hdl

/**
 * And gate: 
 * out = 1 if (a == 1 and b == 1)
 *       0 otherwise
 */

CHIP And {
    IN a, b;
    OUT out;

    PARTS:
    // Put your code here:
    //Left is the 'Nand' pin name while the Right is the current 'And' chip
    Nand(a=a, b=b, out=NandOutput);
    //out=out means the output of this second Nand chip is the 'And' chip
    Nand(a=NandOutput, b=NandOutput, out=out);
}
